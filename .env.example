# Copy to .env and fill in whichever channels you actually use.
# Every value here is a secret; config.yaml holds the non-secret structure.

# --- Discord (easiest: Server Settings -> Integrations -> Webhooks -> New Webhook) ---
TG_DISCORD_WEBHOOK_URL=

# --- ntfy (self-hosted or ntfy.sh; topic doubles as the password, so make it unguessable) ---
TG_NTFY_SERVER=https://ntfy.sh
TG_NTFY_TOPIC=
TG_NTFY_TOKEN=

# --- Telegram (talk to @BotFather to create a bot, then @userinfobot for your chat id) ---
TG_TELEGRAM_BOT_TOKEN=
TG_TELEGRAM_CHAT_ID=

# --- Adapter scaffold/heal agent (optional, only for `tg adapter scaffold|heal`) ---
ANTHROPIC_API_KEY=

# --- Overrides ---
# TG_DATABASE_URL=sqlite:///data/tg.db
# TG_CONFIG_FILE=config.yaml
